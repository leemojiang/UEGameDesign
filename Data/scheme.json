{
  "type": "object",
  "properties": {
    "Object": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "description": "Actor class name, e.g., BP_Tank"
        },
        "name": {
          "type": "string",
          "description": "Optional actor name"
        },

        "transform": {
          "type": "object",
          "properties": {
            "location": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            },
            "rotation": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            },
            "scale": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "additionalProperties": true
        },

        "properties": {
          "type": ["object", "null"],
          "description": "Actor-level Blueprint/C++ properties",
          "additionalProperties": true
        },

        "children": {
          "type": "array",
          "description": "SceneComponent or ChildActor (scene tree nodes)",
          "items": { "$ref": "#/definitions/sceneNode" }
        },

        "components": {
          "type": "array",
          "description": "NonSceneComponent list",
          "items": { "$ref": "#/definitions/nonSceneComponent" }
        },

        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },

        "meta": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },

  "definitions": {
    "sceneNode": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "description": "SceneComponent class (StaticMeshComponent, CameraComponent, etc.)"
        },
        "name": {
          "type": "string",
          "description": "Component name"
        },
        "attach_to": {
          "type": "string",
          "description": "Parent SceneComponent name (default Root)"
        },
        "transform": {
          "type": "object",
          "properties": {
            "location": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            },
            "rotation": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            },
            "scale": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "additionalProperties": true
        },

        "properties": {
          "type": ["object", "null"],
          "additionalProperties": true
        },

        "children": {
          "type": "array",
          "description": "Nested SceneComponents",
          "items": { "$ref": "#/definitions/sceneNode" }
        },

        "child_actor": {
          "type": "object",
          "description": "If this SceneComponent is a ChildActorComponent",
          "required": ["class"],
          "properties": {
            "class": { "type": "string" },
            "properties": {
              "type": ["object", "null"],
              "additionalProperties": true
            },
            "children": {
              "type": "array",
              "items": { "$ref": "#/definitions/sceneNode" }
            },
            "components": {
              "type": "array",
              "items": { "$ref": "#/definitions/nonSceneComponent" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "nonSceneComponent": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "description": "NonSceneComponent class (MovementComponent, VehicleMovement, etc.)"
        },
        "name": {
          "type": "string"
        },
        "properties": {
          "type": ["object", "null"],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
